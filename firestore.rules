rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados pueden leer y escribir
    match /therapy_patients/{patientId} {
      allow read, write: if request.auth != null;
    }

    match /therapy_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /therapy_terapeutas/{terapeutaId} {
      allow read, write: if request.auth != null;
    }

    match /therapy_autorizaciones/{authId} {
      allow read, write: if request.auth != null;
    }

    // Bloquear todo lo demas por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
